{
  "productName": "PulseSeek",
  "version": "1.0.2",
  "identifier": "com.trive.pulseseek",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "wav",
          "wave"
        ],
        "name": "Waveform Audio File",
        "role": "Viewer",
        "mimeType": "audio/x-wav"
      },
      {
        "ext": [
          "mp3"
        ],
        "name": "MPEG Audio File",
        "role": "Viewer",
        "mimeType": "audio/mpeg"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "FLAC Audio File",
        "role": "Viewer",
        "mimeType": "audio/flac"
      },
      {
        "ext": [
          "aif",
          "aiff"
        ],
        "name": "AIFF Audio File",
        "role": "Viewer",
        "mimeType": "audio/aiff"
      },
      {
        "ext": [
          "ogg",
          "oga"
        ],
        "name": "Ogg Vorbis Audio File",
        "role": "Viewer",
        "mimeType": "audio/ogg"
      },
      {
        "ext": [
          "m4a"
        ],
        "name": "MPEG-4 Audio File",
        "role": "Viewer",
        "mimeType": "audio/mp4"
      }
    ]
  },
  "app": {
    "windows": [
      {
        "title": "PulseSeek",
        "width": 1200,
        "height": 800
      }
    ]
  }
}
