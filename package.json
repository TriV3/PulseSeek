{
  "name": "pulseseek",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write package.json pnpm-workspace.yaml index.html src tsconfig.json tsconfig.node.json vite.config.ts vite.config.e2e.ts playwright.config.ts playwright.bench.config.ts eslint.config.js .prettierrc.json",
    "format:check": "prettier --check package.json pnpm-workspace.yaml index.html src tsconfig.json tsconfig.node.json vite.config.ts vite.config.e2e.ts playwright.config.ts playwright.bench.config.ts eslint.config.js .prettierrc.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json && tsc --noEmit --pretty false -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench": "playwright test --config playwright.bench.config.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.8",
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
